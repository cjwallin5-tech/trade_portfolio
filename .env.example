# Copy this file to .env and fill in real values. .env is gitignored.

# SMTP account used to send booking notification emails to pros.
# Example (Gmail): host smtp.gmail.com, port 587, secure false, user your address,
# pass a 16-character App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional — defaults to SMTP_USER if unset.
SMTP_FROM=
