# Copy this file to .env and fill in real values. .env is gitignored.

# Set to "production" on Railway/other hosts. Enables secure session cookies
# and trusts the platform's HTTPS-terminating proxy. Leave unset locally.
NODE_ENV=

# Secret used to sign the login session cookie. Set this to a long random
# string in production — without it, sessions fall back to an insecure
# hardcoded dev default.
SESSION_SECRET=

# Optional — where the SQLite database and uploaded images are stored.
# Defaults to ./data and ./public/uploads. On Railway, mount a Volume and
# point these at its mount path (e.g. /data and /data/uploads) so the
# database and uploaded photos survive redeploys — the container filesystem
# itself is ephemeral.
DATA_DIR=
UPLOADS_DIR=

# SMTP account used to send booking notification emails to pros.
# Example (Gmail): host smtp.gmail.com, port 587, secure false, user your address,
# pass a 16-character App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional — defaults to SMTP_USER if unset.
SMTP_FROM=
